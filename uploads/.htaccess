# Uploaded files must never execute as server-side code — this closes the
# classic "upload a disguised .php file, then request it" RCE path.

# Block direct access to any script-like file that might land here.
<FilesMatch "\.(php|php\d|phtml|phar|pl|py|cgi|sh|asp|aspx)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Belt-and-braces: also strip PHP execution for this directory outright.
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .pl .py .cgi .sh .asp .aspx
RemoveType .php .phtml .php3 .php4 .php5 .php7
