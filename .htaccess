# Harvest Pro — clean URLs (no .php extension) + sitemap/robots at their conventional URLs
<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1) Canonicalize: a direct request that still shows .php gets a permanent
  #    redirect to the clean URL, so search engines only ever see one version.
  RewriteCond %{THE_REQUEST} \s/+index\.php[\s?] [NC]
  RewriteRule ^ /? [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+(about|features|how-it-works|contact|refund-policy|privacy-policy|terms-and-conditions|news)\.php[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # 2) Internally serve the clean URL from its .php file (the address bar stays clean).
  RewriteRule ^about/?$ about.php [L]
  RewriteRule ^features/?$ features.php [L]
  RewriteRule ^how-it-works/?$ how-it-works.php [L]
  RewriteRule ^contact/?$ contact.php [L]
  RewriteRule ^refund-policy/?$ refund-policy.php [L]
  RewriteRule ^privacy-policy/?$ privacy-policy.php [L]
  RewriteRule ^terms-and-conditions/?$ terms-and-conditions.php [L]
  RewriteRule ^news/?$ news.php [L]
  RewriteRule ^news/([a-zA-Z0-9-]+)/?$ news-post.php?slug=$1 [L]

  # sitemap.xml / robots.txt
  RewriteRule ^sitemap\.xml$ sitemap.php [L]
  RewriteRule ^sitemap-news\.xml$ sitemap-news.php [L]
  RewriteRule ^robots\.txt$ robots.php [L]
</IfModule>

# Raise PHP's own upload ceiling to match the 15 MB app-level limit in
# admin/fields.php (only applies on mod_php hosting — PHP-FPM/CGI hosts use
# the .user.ini file instead; this block is a no-op there). post_max_size
# is bigger than a single file's cap since the News post editor can submit
# two files (featured image + a .docx import) in one request.
<IfModule mod_php.c>
  php_value upload_max_filesize 20M
  php_value post_max_size 40M
</IfModule>
<IfModule mod_php7.c>
  php_value upload_max_filesize 20M
  php_value post_max_size 40M
</IfModule>
<IfModule mod_php8.c>
  php_value upload_max_filesize 20M
  php_value post_max_size 40M
</IfModule>
